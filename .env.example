# Configuração de chaves e variáveis do Vortex ASPM
# Copie este arquivo para .env e preencha com as suas configurações:
# cp .env.example .env

# Chave secreta da API do Google Gemini (obrigatória)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo do Google Gemini (opcional, padrão: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
